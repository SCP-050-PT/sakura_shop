# Скопируйте этот файл в .env и заполните. Файл .env НЕ коммитьте.

# Токен бота от @BotFather
BOT_TOKEN=
# ID администраторов через запятую (узнать свой ID: команда /id в боте или @userinfobot)
ADMIN_IDS=

SHOP_NAME=Sakura Shop
# ID чата/канала для логов (бот должен быть там админом). Пусто — логи отключены.
LOG_CHAT_ID=
# Юзернейм для кнопки «Написать админу» (без @). Пусто — кнопки не будет.
SUPPORT_USERNAME=

REFERRAL_PERCENT=10
MIN_DEPOSIT_RUB=10
INVOICE_TTL_MINUTES=30

# База данных. По умолчанию SQLite-файл data/shop.db
DATABASE_URL=sqlite+aiosqlite:///data/shop.db

# SMM-панель (протокол API v2). Пусто — раздел накрутки не принимает заказы.
SMM_API_URL=https://partner.soc-proof.su/api/v2
SMM_API_KEY=

# Crypto Pay API: @CryptoBot -> Crypto Pay -> Create App. Пусто — способ оплаты скрыт.
CRYPTOBOT_TOKEN=
# true — тестовая сеть (@CryptoTestnetBot)
CRYPTOBOT_TESTNET=false

# Сколько рублей зачислять за 1 Telegram Star. 0 — оплата звёздами выключена.
STARS_RUB_RATE=0
